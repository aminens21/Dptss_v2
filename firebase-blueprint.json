        "create": "request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN' || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SPORT_MANAGER' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sportId == request.resource.data.sportId))",
        "update": "request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN' || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SPORT_MANAGER' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sportId == resource.data.sportId))",
        "delete": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN'"
      }
    },
    "venues": {
      "description": "Match venues and locations.",
      "fields": {
        "name": "string",
        "city": "string",
