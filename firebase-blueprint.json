{
  "collections": {
    "users": {
      "description": "User profiles and roles for the application.",
      "fields": {
        "fullName": "string",
        "email": "string",
        "phone": "string (optional)",
        "role": "string (CENTRAL_ADMIN, SPORT_MANAGER, TEACHER, REFEREE)",
        "sportId": "string (optional, for SPORT_MANAGER)",
        "isActive": "boolean",
        "createdAt": "timestamp",
        "updatedAt": "timestamp",
        "createdBy": "string"
      },
      "rules": {
        "read": "request.auth != null",
        "create": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN'",
        "update": "request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN' || request.auth.uid == resource.id)",
        "delete": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN'"
      }
    },
    "sports": {
      "description": "List of sports managed in the directorate.",
      "fields": {
        "name": "string",
        "description": "string",
        "managerId": "string (optional)",
        "ageCategories": "array of strings (optional)"
      },
      "rules": {
        "read": "request.auth != null",
        "create": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN'",
        "update": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN'",
        "delete": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN'"
      }
    },
    "tournaments": {
      "description": "Tournaments and competitions.",
      "fields": {
        "name": "string",
        "seasonId": "string",
        "sportId": "string",
        "ageCategory": "string",
        "gender": "string",
        "level": "string",
        "scope": "string",
        "startDate": "timestamp",
        "endDate": "timestamp",
        "status": "string",
        "description": "string"
      },
      "rules": {
        "read": "true",
        "create": "request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN' || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SPORT_MANAGER' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sportId == request.resource.data.sportId))",
        "update": "request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN' || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SPORT_MANAGER' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sportId == resource.data.sportId))",
        "delete": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN'"
      }
    },
    "schools": {
      "description": "Participating schools.",
      "fields": {
        "name": "string",
        "type": "string",
        "commune": "string",
        "teacherName": "string",
        "phone": "string (optional)"
      },
      "rules": {
        "read": "true",
        "create": "request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SPORT_MANAGER')",
        "update": "request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SPORT_MANAGER')",
        "delete": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN'"
      }
    },
    "teams": {
      "description": "Teams belonging to schools.",
      "fields": {
        "name": "string",
        "schoolId": "string",
        "sportId": "string",
        "gender": "string",
        "category": "string"
      },
      "rules": {
        "read": "true",
        "create": "request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN' || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SPORT_MANAGER' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sportId == request.resource.data.sportId))",
        "update": "request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN' || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SPORT_MANAGER' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sportId == resource.data.sportId))",
